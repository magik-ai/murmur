#!/usr/bin/env python3
"""Check that hq never signs one agent's work with another agent's name.

Two sessions share a machine: alice registers, bob then registers, and a third
session never registers. hq keeps one name per session, so alice must still
resolve to alice, and the third session must resolve to no name at all. Two more
shapes of the same mistake follow: a clone-wide `git config hq.agent`, and a
session whose own name `hq bye` has just removed.

It needs git, and no network, no pytest and no config. Run it from a clone:
`python3 bin/hq-selftest`. It checks the `hq` package in that clone's `src/`.
The pytest suite runs the same checks, and more, in tests/test_identity.py.
"""

import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

SRC = Path(__file__).resolve().parent.parent / "src"
sys.path.insert(0, str(SRC))

from hq import identity  # noqa: E402
from hq.config import load_config  # noqa: E402


def become(key):
    """Be the session with this session key (None: a session with no key)."""
    for variable in identity.SESSION_VARIABLES:
        os.environ.pop(variable, None)
    if key:
        os.environ["HQ_SESSION_ID"] = key


def register(name, key):
    """What `hq hello` writes locally, without the GitHub round-trip."""
    become(key)
    cfg = load_config()
    cfg.state.mkdir(parents=True, exist_ok=True)
    if key:
        cfg.session_dir.mkdir(parents=True, exist_ok=True)
        (cfg.session_dir / key).write_text(name + "\n")
    cfg.identity_file.write_text(name + "\n")
    cfg.identity_owner_file.write_text((key or "") + "\n")


def checkout(where, agent):
    """A throwaway clone whose clone-wide `hq.agent` names `agent`; cd into it."""
    path = where / f"checkout-{agent}"
    subprocess.run(["git", "init", "--quiet", str(path)], check=True)
    subprocess.run(["git", "-C", str(path), "config", "hq.agent", agent], check=True)
    os.chdir(path)


def main():
    if shutil.which("git") is None:
        print("hq-selftest needs git on PATH")
        return 2
    scratch = Path(tempfile.mkdtemp())
    # A sandbox: its own HOME, config dir and state dir, no HQ_ variables, and
    # no git repository or git config from outside it. Neither this machine's
    # identity nor its head office can answer for the checks below.
    os.environ["HOME"] = str(scratch / "home")
    os.environ["XDG_CONFIG_HOME"] = str(scratch / "home" / ".config")
    os.environ["HQ_HOME"] = str(scratch / "state")
    os.environ["GIT_CEILING_DIRECTORIES"] = str(scratch.parent)
    os.environ["GIT_CONFIG_NOSYSTEM"] = "1"
    for variable in ("HQ_AGENT", "HQ_REPO", "HQ_OWNER"):
        os.environ.pop(variable, None)
    os.chdir(scratch)

    failures = []
    register("alice", "session-a")
    register("bob", "session-b")

    become("session-a")
    mine = identity.identity()
    if mine != "alice":
        failures.append("a registered session was renamed by its neighbour: "
                        f"expected 'alice', got {mine!r}")
    become("session-c")
    stranger = identity.identity()
    if stranger is not None:
        failures.append(
            f"an unregistered session inherited a name it never claimed: {stranger!r}")

    # Second shape: `git config hq.agent` is written to .git/config, which every
    # linked worktree of the clone shares. A neighbour setting it must not
    # rename a session that said hello.
    checkout(scratch, "neighbour")
    become("session-a")
    in_checkout = identity.identity()
    if in_checkout != "alice":
        failures.append("a clone-wide git config outranked a registered session: "
                        f"expected 'alice', got {in_checkout!r}")

    # Third shape: after `hq bye` a session has no file of its own, so the next
    # command falls through to shared state. Reading under that name is
    # harmless; acting under it is not, because it may be a different, live
    # agent's name.
    (load_config().session_dir / "session-a").unlink()
    name, source = identity.identity_source()
    if (name, source) != ("neighbour", "clone config"):
        failures.append("after bye, the source of a shared name is not reported: "
                        f"expected ('neighbour', 'clone config'), got {(name, source)!r}")
    try:
        signed = identity.require_identity()  # strict: must refuse shared state
    except SystemExit as refusal:
        signed = None
        if "hello" not in str(refusal):
            failures.append(f"the refusal does not say how to fix it: {refusal}")
    if signed is not None:
        failures.append(
            f"a session with no name of its own acted as {signed!r} from shared state")
    if identity.require_identity(strict=False) != "neighbour":
        failures.append("a read was refused where only writes should be")

    os.chdir(scratch.parent)
    shutil.rmtree(scratch, ignore_errors=True)
    for failure in failures:
        print(f"FAIL: {failure}")
    if failures:
        return 1
    print("ok: a name survives a neighbour's hello and a clone-wide config, is never "
          "inherited, and shared state can be read but never acted on")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
