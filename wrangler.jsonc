// murmur.farm is the Cloudflare Worker "murmur". .github/workflows/site-deploy.yml runs
// `wrangler deploy` on every push to main that changes the site, which publishes site/ as
// static files.
{
  "name": "murmur",
  "compatibility_date": "2026-09-23",
  "assets": { "directory": "./site" },
  "observability": { "enabled": true }
}
