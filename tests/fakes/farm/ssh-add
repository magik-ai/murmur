#!/usr/bin/env python3
"""A fake ssh-add: `-L` lists the public keys in $FAKE_AGENT_KEYS (a file), or none."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _fakelib import die, flag, out, record  # noqa: E402


def main():
    argv = record()
    if argv[1:] == ["-L"]:
        path = flag("FAKE_AGENT_KEYS")
        if path and os.path.exists(path):
            with open(path, encoding="utf-8") as handle:
                body = handle.read().strip()
            if body:
                out(body)
                return 0
        die("The agent has no identities.")
    die("fake ssh-add: adding a key needs a terminal, and this script never does it", 2)


if __name__ == "__main__":
    raise SystemExit(main())
