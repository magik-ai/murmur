#!/usr/bin/env python3
"""A fake ssh-keygen for the laptop: makes a key pair, reads one, finds and forgets host keys.

  FAKE_LOG=<path>               every call appended as one JSON line {argv, stdin}
  FAKE_KEY_PASSPHRASE=1         the person's key has a passphrase: `-y -P ''` fails
  FAKE_SSH_FINGERPRINT=<text>   the MD5 fingerprint `-l` prints
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _fakelib import die, flag, out, record, value_after  # noqa: E402

PUBLIC = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKE"


def lines_of(path):
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read().splitlines()
    except OSError:
        return []


def main():
    argv = record()
    args = argv[1:]
    path = value_after(args, "-f")
    if "-F" in args:
        wanted = value_after(args, "-F")
        found = [line for line in lines_of(path) if line.split(" ", 1)[0] == wanted]
        if not found:
            return 1
        out(f"# Host {wanted} found: line 1\n" + "\n".join(found))
        return 0
    if "-R" in args:
        wanted = value_after(args, "-R")
        kept = [line for line in lines_of(path) if line.split(" ", 1)[0] != wanted]
        if os.path.exists(path):
            with open(path, "w", encoding="utf-8") as handle:
                handle.write("".join(line + "\n" for line in kept))
        return 0
    if "-l" in args:
        out(f"256 MD5:{flag('FAKE_SSH_FINGERPRINT', 'aa:bb:cc:dd:ee:ff')} murmur (ED25519)")
        return 0
    if "-y" in args:
        if flag("FAKE_KEY_PASSPHRASE"):
            die("Load key \"%s\": incorrect passphrase supplied to decrypt private key" % path)
        pub = lines_of(path + ".pub")
        out(pub[0] if pub else PUBLIC)
        return 0
    if "-t" in args:
        folder = os.path.dirname(path)
        if folder:
            os.makedirs(folder, exist_ok=True)
        with open(path, "w", encoding="utf-8") as handle:
            handle.write("-----BEGIN OPENSSH PRIVATE KEY-----\nfake\n"
                         "-----END OPENSSH PRIVATE KEY-----\n")
        os.chmod(path, 0o600)
        with open(path + ".pub", "w", encoding="utf-8") as handle:
            handle.write(f"{PUBLIC} {value_after(args, '-C') or 'murmur'}\n")
        return 0
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
