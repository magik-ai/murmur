#!/usr/bin/env python3
"""A fake gh on the laptop: `auth status` answers from FAKE_GH_LOGGED_OUT."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _fakelib import die, flag, out, record  # noqa: E402


def main():
    argv = record()
    if argv[1:3] == ["auth", "status"]:
        if flag("FAKE_GH_LOGGED_OUT"):
            die("You are not logged into any GitHub hosts. To log in, run: gh auth login")
        out("github.com\n  Logged in to github.com account person (keyring)")
        return 0
    die("fake gh: not a call the laptop script makes: " + " ".join(argv[1:]))


if __name__ == "__main__":
    raise SystemExit(main())
