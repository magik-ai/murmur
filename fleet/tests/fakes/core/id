#!/usr/bin/env python3
"""A fake id, so a test can say which groups this imaginary user is in.

  FAKE_LOG=<path>              every call appended as one JSON line {argv, stdin}
  FAKE_ID_GROUPS="me sudo"     what `id -nG` prints; without it every call goes to the real id
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _fakelib import flag, out, record  # noqa: E402


def real_id():
    here = os.path.dirname(os.path.abspath(__file__))
    for folder in os.environ.get("PATH", "").split(os.pathsep):
        if folder and os.path.abspath(folder) != here:
            candidate = os.path.join(folder, "id")
            if os.access(candidate, os.X_OK):
                return candidate
    return "/usr/bin/id"


def main():
    argv = record()
    if argv[1:] == ["-nG"] and flag("FAKE_ID_GROUPS"):
        out(flag("FAKE_ID_GROUPS"))
        return 0
    os.execv(real_id(), ["id"] + argv[1:])


if __name__ == "__main__":
    raise SystemExit(main())
