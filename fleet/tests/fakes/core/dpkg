#!/usr/bin/env python3
"""A fake dpkg, so a test can say which packages this imaginary box is missing.

  FAKE_LOG=<path>                every call appended as one JSON line {argv, stdin}
  FAKE_DPKG_MISSING="tmux curl"  these packages are not installed; everything else is
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _fakelib import die, flag, out, record  # noqa: E402


def main():
    argv = record()
    args = argv[1:]

    if args[:1] == ["--print-architecture"]:
        out("amd64")
        return 0

    if args[:1] == ["-s"]:
        package = args[1] if len(args) > 1 else ""
        if package in flag("FAKE_DPKG_MISSING").split():
            die(f"dpkg-query: package '{package}' is not installed and no information "
                "is available", 1)
        out(f"Package: {package}\nStatus: install ok installed")
        return 0

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
