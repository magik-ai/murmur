#!/usr/bin/env python3
"""A fake Vercel sandbox CLI, for the login check only.

There is no `sandbox whoami`, so a `list` that answers is the check (UNVERIFIED as an auth
check, and the preset says so).

  FAKE_LOG=<path>              every call appended as one JSON line {argv, stdin}
  FAKE_SANDBOX_LOGGED_IN=1     `sandbox list` answers
  FAKE_SANDBOX_SLEEP=20        answer slowly, so a caller's timeout can fire
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _fakelib import die, flag, out, record, slow  # noqa: E402


def main():
    argv = record()
    slow("SANDBOX")
    args = argv[1:]

    if args[:1] == ["list"]:
        if not flag("FAKE_SANDBOX_LOGGED_IN"):
            die("Error: Not authenticated. Run `sandbox login` first.")
        out("NAME  STATUS  AGE")
        return 0

    die(f"Error: unknown command: {' '.join(args)}")


if __name__ == "__main__":
    raise SystemExit(main())
