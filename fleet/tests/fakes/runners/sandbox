#!/usr/bin/env python3
"""A fake Vercel `sandbox` CLI: create, copy, exec, remove, and a record of every call."""
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _fake  # noqa: E402

argv = sys.argv[1:]


def main():
    if argv[:1] == ["--version"]:
        _fake.log(["sandbox"] + argv)
        print("sandbox 1.4.0")
        return 0
    if argv[:1] == ["create"]:
        _fake.log(["sandbox"] + argv, extra={"handle_exists": _fake.handle_exists()})
        if os.environ.get("FAKE_CREATE_SLOW"):
            # A create still in flight when the farm is stopped: logged, then slow to answer.
            time.sleep(float(os.environ["FAKE_CREATE_SLOW"]))
        print(_fake.value_after(argv, "--name"))
        return 0
    if argv[:1] == ["copy"] and len(argv) >= 3:
        source, target = argv[1], argv[2]
        remote = target.split(":", 1)[1] if ":" in target else target
        extra = {"env_file": _fake.env_file_facts(source)} if remote.endswith(".env") else None
        _fake.log(["sandbox"] + argv, extra=extra)
        if os.environ.get("FAKE_COPY_FAILS"):
            # The sandbox exists by now: this is a failure AFTER the provider made it.
            sys.stderr.write("sandbox: copy failed\n")
            return 1
        _fake.copy_in(source, remote)
        return 0
    if argv[:1] == ["exec"]:
        rest = _fake.after_dashes(argv)
        if rest[:2] == ["bash", "-c"] and len(rest) > 2:
            script = rest[2]
        elif rest[:1] == ["bash"] and len(rest) > 1:
            try:
                with open(_fake.local(rest[1]), encoding="utf-8") as handle:
                    script = handle.read()
            except OSError:
                sys.stderr.write(f"fake sandbox: no such file {rest[1]}\n")
                return 1
        else:
            script = " ".join(rest)
        _fake.log(["sandbox"] + argv, script)
        return _fake.dispatch(script)
    if argv[:1] == ["remove"]:
        _fake.log(["sandbox"] + argv)
        print("removed")
        return 0
    _fake.log(["sandbox"] + argv)
    sys.stderr.write(f"fake sandbox: unknown command {' '.join(argv)}\n")
    return 1


sys.exit(main())
