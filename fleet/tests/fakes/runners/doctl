#!/usr/bin/env python3
"""A fake `doctl` that knows only `harness-runtime`, the way a fresh build might not know it
at all: set FAKE_DOCTL_NO_HARNESS=1 and the help fails, which is what `available()` reads."""
import os
import shutil
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _fake  # noqa: E402

argv = sys.argv[1:]


def main():
    if argv[:1] != ["harness-runtime"]:
        _fake.log(["doctl"] + argv)
        sys.stderr.write(f"Error: unknown command \"{argv[0] if argv else ''}\" for doctl\n")
        return 1
    rest = argv[1:]
    if rest[:1] == ["--help"]:
        _fake.log(["doctl"] + argv)
        if os.environ.get("FAKE_DOCTL_NO_HARNESS"):
            sys.stderr.write("Error: unknown command \"harness-runtime\" for doctl\n")
            return 1
        print("Usage: doctl harness-runtime create|exec|prompt|download|remove")
        return 0
    if rest[:1] == ["create"]:
        spec_path = rest[1] if len(rest) > 1 else ""
        try:
            with open(spec_path, encoding="utf-8") as handle:
                spec_text = handle.read()
        except OSError:
            spec_text = ""
        secrets = {}
        for index, item in enumerate(rest):
            if item == "--secret" and index + 1 < len(rest):
                name, _, source = rest[index + 1].partition("=")
                secrets[name] = _fake.secret_file_facts(source[1:]) if source.startswith("@") \
                    else {"mode": "on-the-command-line", "bytes": len(source)}
        _fake.log(["doctl"] + argv, extra={"spec": spec_text, "secrets": secrets,
                                          "handle_exists": _fake.handle_exists()})
        print(_fake.value_after(rest, "--name"))
        return 0
    if rest[:1] == ["exec"]:
        after = _fake.after_dashes(rest)
        script = after[2] if after[:2] == ["sh", "-c"] and len(after) > 2 else " ".join(after)
        _fake.log(["doctl"] + argv, script)
        return _fake.dispatch(script)
    if rest[:1] == ["prompt"]:
        _fake.log(["doctl"] + argv, _fake.read_stdin())
        return _fake.play_transcript()
    if rest[:1] == ["download"]:
        _fake.log(["doctl"] + argv)
        source = os.path.join(_fake.root(), "workspace",
                              _fake.value_after(rest, "--workspace-path"))
        target = _fake.value_after(rest, "--save-to")
        try:
            shutil.copyfile(source, target)
        except OSError as exc:
            sys.stderr.write(f"Error: {exc}\n")
            return 1
        return 0
    if rest[:1] == ["remove"]:
        _fake.log(["doctl"] + argv)
        print("removed")
        return 0
    _fake.log(["doctl"] + argv)
    sys.stderr.write(f"Error: unknown command \"{rest[0] if rest else ''}\"\n")
    return 1


sys.exit(main())
