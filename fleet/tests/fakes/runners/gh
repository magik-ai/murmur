#!/usr/bin/env python3
"""A fake `gh`: the two calls the farm makes when a runner lane ends, and nothing else."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _fake  # noqa: E402

argv = sys.argv[1:]


def main():
    if argv[:2] == ["pr", "list"]:
        _fake.log(["gh"] + argv)
        print(os.environ.get("FAKE_PR_LIST", "[]"))
        return 0
    if argv[:2] == ["pr", "create"]:
        body = ""
        path = _fake.value_after(argv, "--body-file")
        if path:
            try:
                with open(path, encoding="utf-8") as handle:
                    body = handle.read()
            except OSError:
                body = ""
        _fake.log(["gh"] + argv, extra={"body": body})
        print("https://github.com/fake/repo/pull/7")
        return 0
    _fake.log(["gh"] + argv)
    return 0


sys.exit(main())
