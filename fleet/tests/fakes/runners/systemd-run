#!/usr/bin/env python3
"""A fake `systemd-run`: it records the unit's properties and never starts anything. A test
that really ran a lane's run.sh would run an agent, and that is the one thing it must not do."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _fake  # noqa: E402

_fake.log(["systemd-run"] + sys.argv[1:])
sys.exit(0)
