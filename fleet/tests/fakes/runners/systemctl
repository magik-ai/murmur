#!/usr/bin/env python3
"""A fake `systemctl --user`. No test may stop, start or query a unit on the live farm, and
the reaper's whole decision is a unit's state, so the states come from $FAKE_UNIT_STATES
(a JSON map of unit name to ActiveState; a unit that is missing from it is not loaded)."""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _fake  # noqa: E402

argv = [item for item in sys.argv[1:] if item != "--user"]


def states():
    try:
        return json.loads(os.environ.get("FAKE_UNIT_STATES") or "{}")
    except ValueError:
        return {}


def main():
    _fake.log(["systemctl"] + sys.argv[1:])
    if argv[:1] == ["show"]:
        if os.environ.get("FAKE_SYSTEMCTL_FAILS"):
            # A systemd this process cannot reach (no XDG_RUNTIME_DIR, no user bus).
            sys.stderr.write("Failed to connect to bus: No medium found\n")
            return 1
        unit = argv[1] if len(argv) > 1 else ""
        active = states().get(unit)
        print(f"LoadState={'loaded' if active else 'not-found'}")
        print(f"ActiveState={active or 'inactive'}")
        return 0
    if argv[:1] == ["is-enabled"]:
        return 0 if os.environ.get("FAKE_SWEEP_TIMER", "enabled") == "enabled" else 1
    if argv[:1] == ["is-active"]:
        unit = argv[1] if len(argv) > 1 else ""
        print(states().get(unit, "inactive"))
        return 0
    return 0


sys.exit(main())
